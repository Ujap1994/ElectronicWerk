{
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": ["img", "p", "br", "picture", "source", "a", "details", "summary"],
    },
    "MD041": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "KiCAD-Files/**",
    "DipTrace-Files/**",
    "Muster-Projekte/**",
    "ORIGINAL_REQUEST.md",
    "**/node_modules/**",
    "**/target/**",
    "**/out/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "docs/.vitepress/cache/**",
    "docs/.vitepress/dist/**",
  ],
}
