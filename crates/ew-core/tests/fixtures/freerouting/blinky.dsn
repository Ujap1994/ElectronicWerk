(pcb blinky.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "ElectronicWerk 0.15.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0 65000 40000 0 40000 0 0 65000 0 65000 40000))
    (plane GND (polygon B.Cu 0 1000 1000 64000 1000 64000 39000 1000 39000))
    (via Via[0-1]_800:400_um Via[0-1]_808:300_um Via[0-1]_908:400_um)
    (rule (width 254) (clearance 200) (clearance 50 (type smd_smd)))
  )
  (placement
    (component blinky:C0603_C2 (place C2 45000 30000 front 0))
    (component blinky:C0603_C1 (place C1 8000 20000 front 0))
    (component blinky:LED3MM_D1 (place D1 55000 22000 front 0))
    (component blinky:R0805_R1 (place R1 15000 30000 front 0))
    (component blinky:R0805_R3 (place R3 45000 15000 front 0))
    (component blinky:R0805_R2 (place R2 15000 10000 front 0))
    (component blinky:SO08_U1 (place U1 30000 20000 front 0))
    (component eagle:HOLE_3.2_H1 (place H1 60000 35000 front 0))
    (component blinky:HDR2_J1 (place J1 5000 5000 front 0))
  )
  (library
    (image blinky:C0603_C2
      (pin Pad_1 1 850 0)
      (pin Pad_1 2 -850 0)
    )
    (image blinky:C0603_C1
      (pin Pad_2 1 -850 0)
      (pin Pad_2 2 850 0)
    )
    (image blinky:LED3MM_D1
      (pin Pad_3 A 1270 0)
      (pin Pad_4 C -1270 0)
    )
    (image blinky:R0805_R1
      (pin Pad_5 1 0 -950)
      (pin Pad_5 2 0 950)
    )
    (image blinky:R0805_R3
      (pin Pad_6 1 0 -950)
      (pin Pad_6 2 0 950)
    )
    (image blinky:R0805_R2
      (pin Pad_7 1 0 950)
      (pin Pad_7 2 0 -950)
    )
    (image blinky:SO08_U1
      (pin Pad_8 1 -1905 -2600)
      (pin Pad_8 2 -635 -2600)
      (pin Pad_8 3 635 -2600)
      (pin Pad_8 4 1905 -2600)
      (pin Pad_8 5 1905 2600)
      (pin Pad_8 6 635 2600)
      (pin Pad_8 7 -635 2600)
      (pin Pad_8 8 -1905 2600)
    )
    (image eagle:HOLE_3.2_H1
      (pin Pad_9 @1 0 0)
      (keepout "" (circle signal 3200 0 0))
    )
    (image blinky:HDR2_J1
      (pin Pad_10 1 0 -1270)
      (pin Pad_11 2 0 1270)
    )
    (padstack Pad_4 (shape (circle F.Cu 1600)) (shape (circle B.Cu 1600)) (attach off))
    (padstack Pad_9 (shape (circle F.Cu 3200)) (shape (circle B.Cu 3200)) (attach off))
    (padstack Pad_10 (shape (path F.Cu 1200 0 -600 0 600)) (shape (path B.Cu 1200 0 -600 0 600)) (attach off))
    (padstack Pad_6 (shape (polygon B.Cu 0 -750 -650 -750 650 750 650 750 -650)) (attach off))
    (padstack Pad_1 (shape (polygon B.Cu 0 550 375 550 389.1 543.7 416.5 531.5 441.9 513.9 463.9 491.9 481.5 466.5 493.7 439.1 500 425 500 -425 500 -439.1 500 -466.5 493.7 -491.9 481.5 -513.9 463.9 -531.5 441.9 -543.7 416.5 -550 389.1 -550 375 -550 -375 -550 -389.1 -543.7 -416.5 -531.5 -441.9 -513.9 -463.9 -491.9 -481.5 -466.5 -493.7 -439.1 -500 -425 -500 425 -500 439.1 -500 466.5 -493.7 491.9 -481.5 513.9 -463.9 531.5 -441.9 543.7 -416.5 550 -389.1 550 -375)) (attach off))
    (padstack Pad_8 (shape (polygon F.Cu 0 -300 -1100 300 -1100 300 1100 -300 1100)) (attach off))
    (padstack Pad_2 (shape (polygon F.Cu 0 -550 -375 -550 -389.1 -543.7 -416.5 -531.5 -441.9 -513.9 -463.9 -491.9 -481.5 -466.5 -493.7 -439.1 -500 -425 -500 425 -500 439.1 -500 466.5 -493.7 491.9 -481.5 513.9 -463.9 531.5 -441.9 543.7 -416.5 550 -389.1 550 -375 550 375 550 389.1 543.7 416.5 531.5 441.9 513.9 463.9 491.9 481.5 466.5 493.7 439.1 500 425 500 -425 500 -439.1 500 -466.5 493.7 -491.9 481.5 -513.9 463.9 -531.5 441.9 -543.7 416.5 -550 389.1 -550 375)) (attach off))
    (padstack Pad_7 (shape (polygon F.Cu 0 -750 650 -750 -650 750 -650 750 650)) (attach off))
    (padstack Pad_5 (shape (polygon F.Cu 0 750 -650 750 650 -750 650 -750 -650)) (attach off))
    (padstack Pad_3 (shape (polygon F.Cu 0 800 800 -800 800 -800 -800 800 -800)) (shape (polygon B.Cu 0 800 800 -800 800 -800 -800 800 -800)) (attach off))
    (padstack Pad_11 (shape (polygon F.Cu 0 850 352.1 352.1 850 -352.1 850 -850 352.1 -850 -352.1 -352.1 -850 352.1 -850 850 -352.1)) (shape (polygon B.Cu 0 850 352.1 352.1 850 -352.1 850 -850 352.1 -850 -352.1 -352.1 -850 352.1 -850 850 -352.1)) (attach off))
    (padstack Via[0-1]_800:400_um (shape (circle F.Cu 800)) (shape (circle B.Cu 800)) (attach off))
    (padstack Via[0-1]_808:300_um (shape (circle F.Cu 808)) (shape (circle B.Cu 808)) (attach off))
    (padstack Via[0-1]_908:400_um (shape (circle F.Cu 908)) (shape (circle B.Cu 908)) (attach off))
  )
  (network
    (net GND (pins C1-2 C2-2 D1-C J1-1 U1-1))
    (net TIMING (pins C1-1 R2-1 U1-2 U1-6))
    (net VCC (pins J1-2 R1-2 U1-4 U1-8))
    (net N$1 (pins R1-1 R2-2 U1-7))
    (net N$2 (pins C2-1 U1-5))
    (net N$3 (pins R3-1 U1-3))
    (net LED (pins D1-A R3-2))
    (class Default TIMING N$1 N$2 N$3 LED (circuit (use_via Via[0-1]_808:300_um)) (rule (width 254) (clearance 200)))
    (class power GND VCC (circuit (use_via Via[0-1]_908:400_um)) (rule (width 500) (clearance 300)))
  )
  (wiring
    (wire (path B.Cu 254 31905 24600 40450 24600) (net N$2))
    (wire (path F.Cu 300 47000 15950 56270 22000) (net LED))
    (wire (path F.Cu 254 31905 22600 31905 24600) (net N$2))
    (wire (path B.Cu 254 40450 24600 45850 30000) (net N$2))
    (wire (path B.Cu 300 45000 15950 47000 15950) (net LED))
    (via Via[0-1]_800:400_um 47000 15950 (net LED))
    (via Via[0-1]_800:400_um 31905 24600 (net N$2))
  )
)
